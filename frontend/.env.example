# Cấu hình frontend — copy thành .env.local khi chạy dev.
# Production: không cần file .env — frontend và backend cùng VPS, dùng default http://localhost:8000.
#
# BACKEND_URL được dùng ở 2 nơi:
# - next.config.ts (rewrites /api) -> giá trị bị CỐ ĐỊNH lúc `next build`; đổi thì phải build lại.
# - src/lib/server.ts (SSR fetch)  -> đọc lúc chạy.

BACKEND_URL=http://localhost:8000
