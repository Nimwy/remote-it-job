# systemd unit — Backend FastAPI. Trên VPS: /etc/systemd/system/remoteit-backend.service
# Lấy từ VPS ngày 2026-09-22; khác bản đang chạy đúng 1 chỗ, đánh dấu [THAY ĐỔI].
#
# Cài / cập nhật (chạy tay, xem DEPLOYMENT.md § Cài đặt server):
#   sudo install -m 644 deploy/services/remoteit-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart remoteit-backend

[Unit]
Description=Remote IT Job FastAPI backend
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/remoteit/backend
# [THAY ĐỔI] thêm --proxy-headers --forwarded-allow-ips 127.0.0.1: đây vốn là mặc định của
# uvicorn, ghi rõ để thấy app lấy IP thật của client từ X-Forwarded-For do Nginx gửi
# (rate limit dựa vào IP này). Không đổi hành vi.
ExecStart=/home/deploy/remoteit/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
