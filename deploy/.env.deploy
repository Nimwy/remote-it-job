# Cấu hình PRODUCTION của backend (FastAPI) — cùng danh sách key với backend/.env.example.
# File này ĐƯỢC COMMIT, KHÔNG đặt secret vào đây.
#
# Mỗi lần deploy, .github/workflows/deploy.yml sinh backend/.env từ file này.
# Key để TRỐNG = secret: lấy từ GitHub Secret cùng tên
# (Settings -> Environments -> production). Vẫn trống thì app dùng default trong config.py,
# thiếu biến bắt buộc thì deploy/deploy.sh dừng ở bước "Kiểm tra backend config" trước khi restart.
#
# Cú pháp: KEY=value, không comment cùng dòng, không dùng dấu ' \ hoặc "${" trong giá trị.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=remoteit
DB_USER=remoteit
DB_PASSWORD=

# --- Bảo mật / URL ---
SECRET_KEY=
CORS_ORIGINS=["https://devremote.cc"]
FRONTEND_URL=https://devremote.cc

# --- Tài khoản admin do seed.py tạo ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Môi trường ---
ENV=production
COOKIE_SECURE=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO

# --- Google OAuth (tuỳ chọn — trống thì endpoint trả 501) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://devremote.cc/api/auth/google/callback

# --- Tinh chỉnh ---
# Access token (JWT) sống 15 phút
ACCESS_TOKEN_TTL_SECONDS=900
# Phiên đăng nhập (refresh token) sống 7 ngày
SESSION_MAX_AGE_SECONDS=604800
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
# Số connection DB giữ sẵn / được mở thêm khi cao điểm (mỗi worker uvicorn)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
