# Cấu hình backend — copy thành backend/.env khi chạy ngoài Docker.
# Thứ tự ưu tiên: biến môi trường > backend/.env > default trong app/core/config.py.
#
# Production: KHÔNG sửa tay backend/.env trên VPS. Giá trị production nằm ở deploy/.env.deploy
# (secret để trống, lấy từ GitHub Secrets); deploy.yml sinh lại backend/.env mỗi lần deploy.
# Thêm key mới ở đây thì thêm luôn vào deploy/.env.deploy (nếu là secret: thêm vào env: của
# step "Create .env" trong deploy.yml).
#
# Lưu ý cú pháp dotenv:
# - KHÔNG viết comment cùng dòng sau giá trị rỗng: "KEY=   # x" -> giá trị là "# x".
# - KHÔNG dùng "${...}" trong giá trị: python-dotenv sẽ thay thế nó.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=remoteit
DB_USER=remoteit
# Secret
DB_PASSWORD=

# --- Bảo mật / URL ---
# Secret — openssl rand -hex 32 (production >= 32 ký tự)
SECRET_KEY=
# JSON list
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

# --- Tài khoản admin do seed.py tạo ---
ADMIN_EMAIL=
# Secret
ADMIN_PASSWORD=

# --- Môi trường ---
# development | production
ENV=development
# production: bắt buộc true
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ===== Tuỳ chọn =====

# --- Google OAuth — để trống thì endpoint trả 501 ---
GOOGLE_CLIENT_ID=
# Secret
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Tinh chỉnh ---
# Access token (JWT) sống 15 phút
ACCESS_TOKEN_TTL_SECONDS=900
# Phiên đăng nhập (refresh token) sống 7 ngày
SESSION_MAX_AGE_SECONDS=604800
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
# Số connection DB giữ sẵn / được mở thêm khi cao điểm (mỗi worker uvicorn)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
